[Unit]
Description=Block external USB devices from waking the system
Documentation=file:///usr/local/bin/usb-wake-guard
# Runs before every kind of sleep (suspend, hibernate, suspend-then-hibernate)
# and is stopped again when sleep.target goes away after resume.
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/usb-wake-guard block
ExecStop=/usr/local/bin/usb-wake-guard restore

[Install]
WantedBy=sleep.target
