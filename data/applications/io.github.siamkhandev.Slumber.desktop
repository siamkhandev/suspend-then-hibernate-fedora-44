[Desktop Entry]
Type=Application
Name=Slumber
GenericName=Sleep & Hibernate Manager
Comment=Save battery in sleep with suspend-then-hibernate, like Windows Modern Sleep
Exec=slumber
Icon=io.github.siamkhandev.Slumber
Terminal=false
StartupNotify=true
Categories=Settings;HardwareSettings;GTK;
Actions=KeepAwake;AllowSleep;HibernateNow;
Keywords=hibernate;hibernation;sleep;suspend;standby;battery;save battery;power;lid;lock;windows sleep;modern standby;suspend-then-hibernate;

[Desktop Action KeepAwake]
Name=Keep Awake Until I Turn It Off
Exec=slumber-ctl keep-awake forever

[Desktop Action AllowSleep]
Name=Allow Sleep Again
Exec=slumber-ctl allow-sleep

[Desktop Action HibernateNow]
Name=Hibernate Now
Exec=slumber-ctl hibernate
