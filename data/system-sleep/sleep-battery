#!/bin/bash
# systemd sleep hook: record battery level before and after every sleep.
# Installed to /usr/lib/systemd/system-sleep/; runs as root with $1=pre|post,
# $2=suspend|hibernate|hybrid-sleep|suspend-then-hibernate.
# Shipped by the package but inactive until `slumber-setup enable` records
# SLEEP_REPORT=1 in /etc/slumber/slumber.conf.

SLUMBER_CONF=${SLUMBER_CONF:-/etc/slumber/slumber.conf}
grep -qx 'SLEEP_REPORT=1' "$SLUMBER_CONF" 2>/dev/null || exit 0

LOG=${SLEEP_BATTERY_LOG:-/var/log/sleep-battery.log}
STATE=${SLEEP_BATTERY_STATE:-/run/sleep-battery.pre}
# First battery, whatever it is called (BAT0, BAT1, CMB0, ...); none on desktops.
# Some batteries (e.g. many Dells) report charge_now (uAh) instead of energy_now (uWh).
BAT=
for ps in /sys/class/power_supply/*; do
    [ "$(cat "$ps/type" 2>/dev/null)" = Battery ] || continue
    if [ -r "$ps/energy_now" ] || { [ -r "$ps/charge_now" ] && [ -r "$ps/voltage_now" ]; }; then
        BAT=$ps
        break
    fi
done
[ -n "$BAT" ] || exit 0

# Remaining energy in uWh.
energy_uwh() {
    if [ -r "$BAT/energy_now" ]; then
        cat "$BAT/energy_now"
    else
        echo $(( $(cat "$BAT/charge_now") * $(cat "$BAT/voltage_now") / 1000000 ))
    fi
}

read_bat() {
    echo "$(date +%s) $(cat "$BAT/capacity") $(energy_uwh)"
}

case $1 in
    pre)
        read_bat > "$STATE"
        ;;
    post)
        [ -r "$STATE" ] || exit 0
        read -r s_t s_pct s_uwh < "$STATE"
        read -r e_t e_pct e_uwh < <(read_bat)
        # Any mains adapter online (ADP1, AC, ACAD, ...)
        ac=0
        grep -qx 1 /sys/class/power_supply/*/online 2>/dev/null && ac=1
        # SYSTEMD_SLEEP_ACTION says what actually happened for
        # suspend-then-hibernate (suspend, hibernate, ...).
        echo "start=$s_t end=$e_t mode=$2 action=${SYSTEMD_SLEEP_ACTION:-$2}" \
             "pct_start=$s_pct pct_end=$e_pct uwh_start=$s_uwh uwh_end=$e_uwh ac=$ac" >> "$LOG"
        chmod 644 "$LOG"
        rm -f "$STATE"
        ;;
esac
exit 0
